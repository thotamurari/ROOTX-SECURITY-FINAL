# ═══════════════════════════════════════
# SafeOpen / RootX-Security Backend — Environment Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ═══════════════════════════════════════

NODE_ENV=development
PORT=3000

# ── Supabase Database ──────────────────────────────────────
# URL + anon key are safe to expose. The service-role key is SECRET and is
# required for the backend to read/write on behalf of Firebase-authed users
# (Supabase Dashboard → Project Settings → API → service_role secret).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ── Firebase Admin (server-side ID token verification) ─────
# Firebase Console → Project Settings → Service Accounts → Generate new private
# key. Keep the \n escapes inside the private key on a single line.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ── External Threat Intelligence APIs (all optional) ───────
# Scans still run without these, but with fewer signals.
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
SECURITYTRAILS_API_KEY=
ABUSEIPDB_API_KEY=
MAXMIND_LICENSE_KEY=

# ── AI providers ───────────────────────────────────────────
# Gemini powers RootX-AI chat AND the Gemini URL-scan verdict. Server-only.
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── AWS S3 (optional, for file storage) ────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ── Frontend URLs (CORS allow-list, comma-separated) ───────
FRONTEND_URL=http://localhost:5173,http://localhost:3000
